# Agent Sentinel — example environment. No secrets are required to run this project.
# Copy to .env and adjust only if you need non-default values.

# SQLite database location (any SQLAlchemy URL works)
DATABASE_URL=sqlite:///./backend/sentinel.db

# Trained model + evaluation report produced by backend/ml/train_model.py
MODEL_PATH=./backend/ml/models/agent_behavior_model.joblib
EVALUATION_PATH=./backend/ml/models/evaluation.json

# Guardrail policy (editable without touching code)
POLICY_PATH=./backend/app/policies/agent_policy.json

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds between simulated agent actions (lower = faster demo)
SIMULATION_STEP_DELAY=1.1

# Frontend: leave unset to use the Vite dev proxy
# VITE_API_BASE=http://127.0.0.1:8000
